+    // custom (ios): host API. Send a surface's frame to its canvas again, whole (PixMap.resend): the HUD does it for a
+    // surface it shows again, which may have lost its pixels meanwhile.
+    public resendSurface(area: 'game' | 'map' | 'side' | 'chat'): void {
+        if (!this.surfaceLayout) {
+            return;
+        }
+
+        const pixmap: PixMap | null = area === 'game' ? this.areaGame : area === 'map' ? this.areaMap : area === 'side' ? this.areaSide : this.areaChat;
+        pixmap?.resend();
+    }
+
+    // custom (ios): every frame, what each canvas should show goes to it again, whole, every few seconds and after an
+    // invalidate (PixMap.keepShown): a PixMap drawn only when its content changes would stay blank after the browser
+    // dropped its canvas's pixels
+    private keepCanvasesShown(pixmaps: (PixMap | null)[]): void {
+        const now: number = performance.now();
+        for (const pixmap of pixmaps) {
+            pixmap?.keepShown(now);
+        }
+    }
+
