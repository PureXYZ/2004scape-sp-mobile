+    // custom (ios): host API (Settings › Tap options, as OSRS's "NPC/Player 'Attack' options"). What a tap does with the
+    // Attack option of an NPC, and of a player (in the Wilderness): 'tap' makes Attack the top entry whatever their level,
+    // 'level' (upstream) only when their combat level is not above yours, 'hold' never (Attack stays in the long-press
+    // menu and a tap does the next entry, often Walk here), 'hidden' leaves Attack out of the menu. Anything else is
+    // 'level'. Returns the options now on.
+    public setAttackOptions(npc: string, player: string): { npc: AttackOption; player: AttackOption } {
+        const option = (value: string): AttackOption => (value === 'tap' || value === 'hold' || value === 'hidden' ? value : 'level');
+        this.npcAttackOption = option(npc);
+        this.playerAttackOption = option(player);
+        return { npc: this.npcAttackOption, player: this.playerAttackOption };
+    }
+
+    // custom (ios): the priority of an Attack entry on something of this combat level (see setAttackOptions): 0 for a top
+    // entry, MiniMenuAction._PRIORITY to sort it below the others, -1 to leave it out
+    private attackPriority(option: AttackOption, level: number): number {
+        if (option === 'hidden') {
+            return -1;
+        }
+        if (option === 'hold' || (option === 'level' && this.localPlayer && level > this.localPlayer.combatLevel)) {
+            return MiniMenuAction._PRIORITY;
+        }
+        return 0;
+    }
+
