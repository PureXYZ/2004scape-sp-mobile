--- /dev/null
+++ b/src/dash3d/IncrVerify.ts
@@ -0,0 +1,234 @@
+import Pix2D from '#/graphics/Pix2D.js';
+import Pix3D from '#/dash3d/Pix3D.js';
+import Model from '#/dash3d/Model.js';
+import World from '#/dash3d/World.js';
+import IncrRender from '#/dash3d/IncrRender.js';
+
+// custom (ios): the incremental 3D render's verify mode (patch 0029), in debug builds only (IncrRender.verify; World
+// calls it when LC_INCR_VERIFY). Each frame it first draws upstream's full frame (World.incrBypass) from the state the
+// frame starts with, then puts that state back, lets IncrRender draw the frame as it would have anyway, and compares:
+// every pixel of the 3D frame, and the state a full frame leaves (the picked entities in order, the ground tile the
+// pointer picked, whether textures 17 and 24 will animate, and every source's minY, height and animation state). So the
+// build under test runs as without the check, and a partial frame, or a full one, that differs is counted.
+
+// true in debug builds only (web/client/build.mjs)
+declare const LC_INCR_VERIFY: boolean;
+
+type Source = Record<string, unknown>;
+
+const SOURCE_FIELDS: string[] = ['minY', 'height', 'locModel', 'anim', 'animFrame', 'animCycle'];
+
+export default class IncrVerify {
+    static readonly stats = {
+        frames: 0,
+        partial: 0,
+        full: 0,
+        badFrames: 0, // a pixel differs
+        badPartial: 0,
+        badPixels: 0,
+        badState: 0, // the state differs
+        mismatches: [] as Record<string, unknown>[],
+        stateMismatches: [] as string[]
+    };
+
+    private static oracle: Int32Array = /* @__PURE__ */ new Int32Array(0);
+    static touching: boolean = false;
+    private static touched: Source[] = [];
+    private static readonly touchedSet: Set<Source> = new Set();
+    private static before: unknown[][] = [];
+
+    static reset(): void {
+        const s = this.stats;
+        s.frames = 0;
+        s.partial = 0;
+        s.full = 0;
+        s.badFrames = 0;
+        s.badPartial = 0;
+        s.badPixels = 0;
+        s.badState = 0;
+        s.mismatches = [];
+        s.stateMismatches = [];
+    }
+
+    // ModelSource.worldRender, while touching: the first time a source is drawn this frame, what it held before
+    static touch(source: object): void {
+        const s: Source = source as Source;
+        if (this.touchedSet.has(s)) {
+            return;
+        }
+        this.touchedSet.add(s);
+        this.touched.push(s);
+        this.before.push(SOURCE_FIELDS.map((f: string): unknown => s[f]));
+    }
+
+    private static takeTouched(): { list: Source[]; before: unknown[][] } {
+        const out = { list: this.touched, before: this.before };
+        this.touched = [];
+        this.before = [];
+        this.touchedSet.clear();
+        return out;
+    }
+
+    static frame(world: World, eyeX: number, eyeY: number, eyeZ: number, maxLevel: number, eyeYaw: number, eyePitch: number, getClick: () => boolean, setClick: (click: boolean) => void, draw: () => string): string {
+        const out: Int32Array = Pix2D.pixels;
+        const n: number = Pix2D.width * Pix2D.height;
+        const stats = this.stats;
+
+        // the state upstream's frame reads and writes, as this frame starts
+        const picked0: number = Model.pickedCount;
+        const pickedList0: Int32Array = Model.pickedEntityTypecode.slice(0, picked0);
+        const click0: boolean = getClick();
+        const clickX0: number = World.clickX;
+        const clickY0: number = World.clickY;
+        const groundX0: number = World.groundX;
+        const groundZ0: number = World.groundZ;
+        const cycle0: number = Pix3D.cycle;
+        const texCycle0: Int32Array = Pix3D.texCycle.slice();
+
+        // 1. upstream's frame
+        if (this.oracle.length < n) {
+            this.oracle = new Int32Array(n);
+        }
+        const oracle: Int32Array = this.oracle;
+        oracle.fill(0, 0, n);
+        this.takeTouched();
+        IncrRender.touch = (source: object): void => IncrVerify.touch(source);
+        this.touching = true;
+        Pix2D.pixels = oracle;
+        World.incrBypass = true;
+        try {
+            world.renderAll(eyeX, eyeY, eyeZ, maxLevel, eyeYaw, eyePitch);
+        } finally {
+            World.incrBypass = false;
+            Pix2D.pixels = out;
+            this.touching = false;
+            IncrRender.touch = null;
+        }
+        const upstream = this.takeTouched();
+        const upstreamAfter: unknown[][] = upstream.list.map((s: Source): unknown[] => SOURCE_FIELDS.map((f: string): unknown => s[f]));
