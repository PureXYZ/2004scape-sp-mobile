+                if (SOURCE_FIELDS[f] in s) {
+                    s[SOURCE_FIELDS[f]] = was[f];
+                }
+            }
+        }
+        Model.pickedCount = picked0;
+        Model.pickedEntityTypecode.set(pickedList0);
+        setClick(click0);
+        World.clickX = clickX0;
+        World.clickY = clickY0;
+        World.groundX = groundX0;
+        World.groundZ = groundZ0;
+        Pix3D.cycle = cycle0;
+        Pix3D.texCycle.set(texCycle0);
+
+        // 3. this build's frame
+        IncrRender.touch = (source: object): void => IncrVerify.touch(source);
+        this.touching = true;
+        let what: string;
+        try {
+            what = draw();
+        } finally {
+            this.touching = false;
+            IncrRender.touch = null;
+        }
+        const mine = this.takeTouched();
+
+        // 4. compare
+        stats.frames++;
+        const partial: boolean = what === 'partial';
+        if (partial) {
+            stats.partial++;
+        } else {
+            stats.full++;
+        }
+
+        let bad: number = 0;
+        let first: number = -1;
+        let x0: number = 1e9;
+        let x1: number = -1;
+        let y0: number = 1e9;
+        let y1: number = -1;
+        const w: number = Pix2D.width;
+        for (let i: number = 0; i < n; i++) {
+            if (out[i] !== oracle[i]) {
+                if (bad++ === 0) {
+                    first = i;
+                }
+                const x: number = i % w;
+                const y: number = (i / w) | 0;
+                if (x < x0) x0 = x;
+                if (x > x1) x1 = x;
+                if (y < y0) y0 = y;
+                if (y > y1) y1 = y;
+            }
+        }
+        if (bad > 0) {
+            stats.badFrames++;
+            if (partial) {
+                stats.badPartial++;
+            }
+            stats.badPixels += bad;
+            if (stats.mismatches.length < 50) {
+                stats.mismatches.push({ frame: stats.frames, what, px: bad, box: [x0, x1, y0, y1], first: [first % w, (first / w) | 0], mine: out[first], upstream: oracle[first], inRegion: IncrRender.regionHas(first % w, (first / w) | 0) });
+            }
+        }
+
+        const problems: string[] = [];
+        const pickedM: Int32Array = Model.pickedEntityTypecode.slice(0, Model.pickedCount);
+        if (pickedM.length !== pickedU.length || pickedM.some((v: number, i: number): boolean => v !== pickedU[i])) {
+            problems.push(`picked ${pickedM.join(',')} vs ${pickedU.join(',')}`);
+        }
+        if (getClick() !== clickU || World.groundX !== groundXU || World.groundZ !== groundZU) {
+            problems.push(`ground ${getClick()} ${World.groundX},${World.groundZ} vs ${clickU} ${groundXU},${groundZU}`);
+        }
+        if ((Pix3D.texCycle[17] >= cycle0) !== tex17U || (Pix3D.texCycle[24] >= cycle0) !== tex24U) {
+            problems.push(`textures ${Pix3D.texCycle[17] >= cycle0},${Pix3D.texCycle[24] >= cycle0} vs ${tex17U},${tex24U}`);
+        }
+        const mineSet: Set<Source> = new Set(mine.list);
+        const upstreamSet: Set<Source> = new Set(upstream.list);
+        for (let i: number = 0; i < upstream.list.length; i++) {
+            const s: Source = upstream.list[i];
+            if (!mineSet.has(s)) {
+                problems.push(`source ${s.constructor?.name} drawn by upstream only`);
+                continue;
+            }
+            for (let f: number = 0; f < SOURCE_FIELDS.length; f++) {
+                const name: string = SOURCE_FIELDS[f];
+                if (name in s && s[name] !== upstreamAfter[i][f]) {
+                    problems.push(`source ${s.constructor?.name} ${name} ${String(s[name])} vs ${String(upstreamAfter[i][f])}`);
+                }
+            }
+        }
+        for (const s of mine.list) {
+            if (!upstreamSet.has(s)) {
+                problems.push(`source ${s.constructor?.name} drawn by this build only`);
+            }
+        }
+        if (problems.length > 0) {
+            stats.badState++;
+            if (stats.stateMismatches.length < 50) {
+                stats.stateMismatches.push(`frame ${stats.frames} (${what}): ${problems.slice(0, 4).join('; ')}`);
+            }
+        }
+
+        return what;
+    }
+}
+
+// debug builds: the desktop tests' handle (web/test/e2e.mjs, hud.mjs): IncrRender.verify on, the stats read
+if (LC_INCR_VERIFY) {
+    (globalThis as unknown as Record<string, unknown>).__lcIncr = { IncrRender, IncrVerify, last: (): string => World.incrLast };
+}
