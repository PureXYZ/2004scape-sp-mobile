+            const reason: string = j < 0 ? `${name}:new` : kind === K_SOURCE ? `${name}:same` : (this.ref.ints[j * 8 + 6] & (F_TEX17 | F_TEX24)) !== 0 ? `${name}:tex` : x0 > x1 ? `${name}:none` : kind === K_MODEL ? 'model:pick' : 'ground:click';
