+        const clickU: boolean = getClick();
+        const groundXU: number = World.groundX;
+        const groundZU: number = World.groundZ;
+        const tex17U: boolean = Pix3D.texCycle[17] >= cycle0;
+        const tex24U: boolean = Pix3D.texCycle[24] >= cycle0;
