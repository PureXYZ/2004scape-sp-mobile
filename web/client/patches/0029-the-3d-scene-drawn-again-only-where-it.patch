+++ b/src/dash3d/IncrRender.ts
@@ -0,0 +1,1074 @@
+import Pix2D from '#/graphics/Pix2D.js';
+import PixMap from '#/graphics/PixMap.js';
+import Pix3D from '#/dash3d/Pix3D.js';
+
+import type Model from '#/dash3d/Model.js';
+import type World from '#/dash3d/World.js';
+
+// custom (ios): the incremental 3D render (patch 0029). With the camera still, a frame differs from the one before only
+// where something it draws changed, so only that part is drawn again, with the same pixels a full render gives.
+//
+// Every frame World.renderAll draws is a sequence of draw items in its painter's order: ground tiles
+// (renderQuickGround, renderGround) and model placements (Model.worldRender for the scene's models,
+// ModelSource.worldRender for players, NPCs, projectiles, spot anims, animated locs and ground items). A pixel is the
+// result of the items that write it, in that order. So with the same camera, a pixel can only differ from the frame
+// before when an item writing it is new, gone, changed, or drawn in another order relative to the others (World.fill's
+// tile order depends on every sprite on the tiles, and players and NPCs are re-added each frame, so one moving can make
+// two unchanged locs elsewhere swap: the incremental render's prototype missed that). Hence:
+//
+// 1. Pass 1 runs upstream's traversal unchanged, with every side effect in upstream's order (getTempModel and what it
+//    sets, minY, picking, the ground pick, getTexels), but draws nothing. Each item is matched with the item of the
+//    reference frame (the last one drawn) drawn the same way: the same object and arguments, and for a source the same
+//    model content (IncrSig: the vertices and face alphas by value, the face arrays it shares with a cached model by
+//    identity). A matched item is left as it is (deferred: no projection, no face sorting): it keeps the reference's
+//    box and a copy of the reference's recorded triangles. Any other is recorded triangle by triangle (Pix3D.incrMode
+//    1). Never deferred: a model the pointer may pick (render2 picks in upstream's order), anything asking for texture
+//    17 or 24 (which of them animate depends on that, Client.textureRunAnims), the ground while World.click is pending.
+// 2. The region to draw again: the box of every item without a match and of every reference item left without one, of
+//    every item using texture 17 or 24 if it moved since, and, per 16 px tile, wherever two matched items drawn there
+//    are in another order than in the reference (two unchanged items that overlap change a pixel only by swapping).
+// 3. Blends: a blended span writes each pixel from the one to its right (Pix3D's dst[off++] = ... dst[off]), so an
+//    unchanged blending item can change left of a changed pixel, and drawing only part of the frame must not let a
+//    blend read a pixel that part does not draw. One rule closes both, to a fixpoint: where the region meets a blending
+//    item's box in a row of tiles, it covers that box to one pixel beyond its right edge in that row.
+// 4. The region is cleared in a scratch frame and drawn there again from the recorded triangles, item by item in order,
+//    each triangle only when its box touches the region and each span only when it meets the region's columns in its
+//    row (Pix3D.incrReplay, incrRowMin). Every pixel in the region is then exactly the full render's; the region goes
+//    into the persistent frame, and that to the output. Outside the region nothing drawn there changed.
+//
+// A frame is drawn in full (upstream's renderAll as is) when the camera, the level, the viewport or the zoom changed
+// since the frame before ('camera'). The next one is drawn in full too, recording every item ('settle', Pix3D.incrMode
+// 3), and the ones after it are partial. Also in full, measuring: after a change to the world (World's
+// set/del/add/move/reset methods, LOC_ANIM), to the colour table, the textures or the clipping, after PixMap.invalidate
+// (the page shown again, a canvas restored, a resize), at least every 64 frames and every 1.5 s (a safety net), and
+// when the region would cover most of the frame. World.incrBypass draws upstream's frame without any of this (for
+// tests); World.incrLast says what the last renderAll did.
+
+// eslint-disable-next-line @typescript-eslint/no-unused-vars
+declare const LC_INCR_VERIFY: boolean;
+
+const K_QGROUND: number = 1;
+const K_GROUND: number = 2;
+const K_MODEL: number = 3;
+const K_SOURCE: number = 4;
+
+const F_BLEND: number = 1; // a blended triangle (Pix3D.incrTriangle)
+const F_TEX17: number = 2; // asked for texture 17 (Pix3D.textureTriangle)
+const F_TEX24: number = 4; // asked for texture 24
+const F_VOLATILE: number = 8; // never matches another frame's item
+const F_DEFERRED: number = 16; // left as it was: the reference's box and triangles (pass 1)
+
+const FULL_FRAMES: number = 64; // a full frame at least this often (frames) ...
+const FULL_MS: number = 1500; // ... and this often (ms)
+const MAX_SHARE: number = 0.6; // more of the frame than this: draw it all
+
+class IncrStream {
+    n: number = 0;
+    obj: (object | null)[] = [];
+    ints: Int32Array = new Int32Array(8 * 1024); // kind, a, b, c, d, key, flags, typecode
+    box: Int32Array = new Int32Array(4 * 1024); // x0, x1, y0, y1 (x0 > x1: none)
+    cmd: Int32Array = new Int32Array(2 * 1024); // its triangles: a range of the frame's Pix3D.incrCmd
+    valid: boolean = false;
+    tex17: number = 0;
+    tex24: number = 0;
+
+    add(): number {
+        const i: number = this.n++;
+        if (this.n * 8 > this.ints.length) {
+            const ints: Int32Array = new Int32Array(this.ints.length * 2);
+            ints.set(this.ints);
+            this.ints = ints;
+            const box: Int32Array = new Int32Array(this.box.length * 2);
+            box.set(this.box);
+            this.box = box;
+            const cmd: Int32Array = new Int32Array(this.cmd.length * 2);
+            cmd.set(this.cmd);
+            this.cmd = cmd;
+        }
+        return i;
+    }
+
+    clear(): void {
+        this.obj.fill(null, 0, this.n); // (no references to old models or tiles are kept)
+        this.n = 0;
+        this.valid = false;
+    }
+}
+
+// what a source's model drew with: the face arrays (shared from the cached model a temp model is made from), by
+// identity, the vertices and face alphas (copied into scratch arrays for each temp model) by value, and the fields
+// worldRender and render2 read: the same content draws the same triangles at the same place.
+class IncrSig {
+    version: number = -1;
+    readonly ints: Int32Array = new Int32Array(8);
+    readonly refs: (Int32Array | null)[] = new Array(12).fill(null);
+    vx: Int32Array = new Int32Array(0);
+    vy: Int32Array = new Int32Array(0);
+    vz: Int32Array = new Int32Array(0);
+    alpha: Int32Array | null = null;
+
+    // the same content as last time, else taken as the new content
+    same(m: Model): boolean {
+        const n: number = m.numPoints;
+        const faces: number = m.numFaces;
+        const ints: Int32Array = this.ints;
+        const refs: (Int32Array | null)[] = this.refs;
+        const px: Int32Array | null = m.pointX;
+        const py: Int32Array | null = m.pointY;
+        const pz: Int32Array | null = m.pointZ;
+        const fa: Int32Array | null = m.faceAlpha;
+
+        let same: boolean =
+            this.version >= 0 &&
+            px !== null &&
+            py !== null &&
+            pz !== null &&
+            ints[0] === n &&
+            ints[1] === faces &&
+            ints[2] === m.numT &&
+            ints[3] === m.radius &&
+            ints[4] === m.minY &&
+            ints[5] === m.maxDepth &&
+            ints[6] === m.minDepth &&
+            (fa === null) === (this.alpha === null) &&
+            refs[0] === m.faceVertexA &&
+            refs[1] === m.faceVertexB &&
+            refs[2] === m.faceVertexC &&
+            refs[3] === m.faceColourA &&
+            refs[4] === m.faceColourB &&
+            refs[5] === m.faceColourC &&
+            refs[6] === m.faceColour &&
+            refs[7] === m.faceRenderType &&
+            refs[8] === m.facePriority &&
+            refs[9] === m.faceTextureP &&
+            refs[10] === m.faceTextureM &&
+            refs[11] === m.faceTextureN;
+
+        if (same) {
+            const vx: Int32Array = this.vx;
+            const vy: Int32Array = this.vy;
+            const vz: Int32Array = this.vz;
+            for (let v: number = 0; v < n; v++) {
+                if (vx[v] !== px![v] || vy[v] !== py![v] || vz[v] !== pz![v]) {
+                    same = false;
+                    break;
+                }
+            }
+        }
+        if (same && fa !== null) {
+            const alpha: Int32Array = this.alpha!;
+            for (let f: number = 0; f < faces; f++) {
+                if (alpha[f] !== fa[f]) {
+                    same = false;
+                    break;
+                }
+            }
+        }
+        if (same) {
+            return true;
+        }
+
+        ints[0] = n;
+        ints[1] = faces;
+        ints[2] = m.numT;
+        ints[3] = m.radius;
+        ints[4] = m.minY;
+        ints[5] = m.maxDepth;
+        ints[6] = m.minDepth;
+        refs[0] = m.faceVertexA;
+        refs[1] = m.faceVertexB;
+        refs[2] = m.faceVertexC;
+        refs[3] = m.faceColourA;
+        refs[4] = m.faceColourB;
+        refs[5] = m.faceColourC;
+        refs[6] = m.faceColour;
+        refs[7] = m.faceRenderType;
+        refs[8] = m.facePriority;
+        refs[9] = m.faceTextureP;
+        refs[10] = m.faceTextureM;
+        refs[11] = m.faceTextureN;
+        if (this.vx.length < n) {
+            this.vx = new Int32Array(n + 32);
+            this.vy = new Int32Array(n + 32);
+            this.vz = new Int32Array(n + 32);
+        }
+        if (px && py && pz) {
+            const vx: Int32Array = this.vx;
+            const vy: Int32Array = this.vy;
+            const vz: Int32Array = this.vz;
+            for (let v: number = 0; v < n; v++) {
+                vx[v] = px[v];
+                vy[v] = py[v];
+                vz[v] = pz[v];
+            }
+        }
+        if (fa !== null) {
+            if (this.alpha === null || this.alpha.length < faces) {
+                this.alpha = new Int32Array(faces + 32);
+            }
+            const alpha: Int32Array = this.alpha;
+            for (let f: number = 0; f < faces; f++) {
+                alpha[f] = fa[f];
+            }
+        } else {
+            this.alpha = null;
+        }
+        return false;
+    }
+}
+
+export default class IncrRender {
+    // on by default; tests may turn it off (World.incrBypass instead draws one frame without it)
+    static enabled: boolean = true;
+    // spans outside the region are not drawn (Pix3D.incrRowMin); tests may turn it off to compare
+    static rowSkip: boolean = true;
+    // debug builds: check every frame against a full render (World.incrVerifyFrame); 0 = off
+    static verify: number = 0;
+
+    // debug builds: IncrVerify's note of each source drawn (ModelSource.worldRender), or null
+    static touch: ((source: object) => void) | null = null;
+
+    static track: boolean = false; // items are being recorded (pass 1, or a full frame that measures)
+    static inSource: boolean = false; // inside a ModelSource's item (its model is part of it)
+    private static readonly sigs: WeakMap<object, IncrSig> = new WeakMap();
+    private static versions: number = 0;
+    static inside: boolean = false; // World.renderAll is running for this class (draws upstream's frame)
+
+    private static pass1: boolean = false;
+    private static click: boolean = false;
+
+    private static ref: IncrStream = new IncrStream();
+    private static cur: IncrStream = new IncrStream();
+    private static refCmd: Int32Array = new Int32Array(1 << 16); // the reference's triangles (Pix3D.incrCmd: this frame's)
+    private static cursor: number = 0; // where the next item most likely is in the reference
+    // the reference's first item of each object, and the next one of the same object (sameObj; -1: none), built once a
+    // frame needs them. The Map is kept from frame to frame and an entry is believed only where the reference holds
+    // that object at that index, so a frame drawing the objects of the frame before allocates nothing. It is emptied
+    // when the reference is dropped, and at a frame that measures once it holds many objects the reference does not.
+    private static readonly byObj: Map<object, number> = new Map();
+    private static sameObj: Int32Array = new Int32Array(1024);
+    private static byObjBuilt: boolean = false;
+    private static used: Uint8Array = new Uint8Array(1024); // reference items matched this frame
+    private static order: Int32Array = new Int32Array(0); // per tile: the latest reference position drawn there yet
+    private static cols: number = 0;
+    private static item: number = -1; // the current item (cur)
+    private static match: number = -1; // its reference item, or -1
+    private static blends: Int32Array = new Int32Array(256); // this frame's items that blend ...
+    private static blendCount: number = 0; // ... how many
+
+    private static width: number = 0;
+    private static height: number = 0;
+    private static words: number = 0;
+    private static rows: number = 0;
+    private static frame3d: Int32Array = new Int32Array(0); // the last frame's 3D pixels
+    private static scratch: Int32Array = new Int32Array(0);
+    private static region: Int32Array = new Int32Array(0); // tiles drawn again (bits)
+
+    private static readonly key: Int32Array = new Int32Array(12);
+    private static readonly lastKey: Int32Array = new Int32Array(12);
+    private static lastWorld: World | null = null;
+    private static lastOut: Int32Array | null = null;
+    private static lastScanline: Int32Array | null = null;
+    private static lastWorldGen: number = -1;
+    private static lastPix3DGen: number = -1;
+    private static lastPixMapGen: number = -1;
+    private static sinceFull: number = 0;
+    private static lastFullMs: number = 0;
+    private static fullFor: number = 0; // frames left to draw in full (after a frame that was mostly dirty)
+
+    // what the last frames did (also for tests)
+    static readonly stats = { partial: 0, full: 0, reasons: {} as Record<string, number>, tiles: 0, tilesDrawn: 0, deferred: 0, recorded: 0 }; // (deferred, recorded: debug builds)
+    // debug builds: why items were recorded in pass 1, and the biggest boxes of frames that were mostly dirty
+    static readonly why: Record<string, number> = {};
+    static readonly dirtyEvents: string[] = [];
+    private static readonly biggest: string[] = [];
+
+    // ---------------------------------------------------------------------------------------------- the frame
+
+    // World.renderAll's arguments plus what of World it needs; draws this frame's 3D pixels into Pix2D.pixels
+    static frame(world: World, eyeX: number, eyeY: number, eyeZ: number, maxLevel: number, eyeYaw: number, eyePitch: number, minLevel: number, worldGen: number, lowMem: boolean, click: boolean): string {
+        const out: Int32Array = Pix2D.pixels;
+        const w: number = Pix2D.width;
+        const h: number = Pix2D.height;
+
+        const key: Int32Array = this.key;
+        key[0] = eyeX;
+        key[1] = eyeY;
+        key[2] = eyeZ;
+        key[3] = maxLevel;
+        key[4] = eyeYaw;
+        key[5] = eyePitch;
+        key[6] = minLevel;
+        key[7] = Pix3D.originX;
+        key[8] = Pix3D.originY;
+        key[9] = w;
+        key[10] = h;
+        key[11] = (lowMem ? 1 : 0) | (Pix3D.lowDetail ? 2 : 0) | (Pix3D.lowMem ? 4 : 0);
+
+        let moved: boolean = world !== this.lastWorld || out !== this.lastOut || Pix3D.scanline !== this.lastScanline;
+        for (let i: number = 0; i < 12 && !moved; i++) {
+            moved = key[i] !== this.lastKey[i];
+        }
+        this.lastKey.set(key);
+        this.lastWorld = world;
+        this.lastOut = out;
+        this.lastScanline = Pix3D.scanline;
+
+        const pixMapGen: number = PixMap.incrGeneration();
+        const changed: boolean = worldGen !== this.lastWorldGen || Pix3D.incrGen !== this.lastPix3DGen || pixMapGen !== this.lastPixMapGen;
+        this.lastWorldGen = worldGen;
+        this.lastPix3DGen = Pix3D.incrGen;
+        this.lastPixMapGen = pixMapGen;
+
+        let why: string | null = null;
+        if (!this.enabled) {
+            why = 'full:off';
+        } else if (out.length !== w * h || Pix2D.clipMinX !== 0 || Pix2D.clipMinY !== 0 || Pix2D.clipMaxX !== w || Pix2D.clipMaxY !== h || w < 16 || h < 16) {
+            why = 'full:target';
+        } else if (moved) {
+            why = 'full:camera';
+        }
+
+        if (why !== null) {
+            this.drop();
+            this.plain(world, eyeX, eyeY, eyeZ, maxLevel, eyeYaw, eyePitch);
+            return this.count(why);
+        }
+
+        const now: number = performance.now();
+        if (!this.ref.valid) {
+            why = 'full:settle';
+        } else if (changed) {
+            why = 'full:world';
+        } else if (++this.sinceFull >= FULL_FRAMES || now - this.lastFullMs >= FULL_MS) {
+            why = 'full:refresh';
+        } else if (this.fullFor > 0) {
+            this.fullFor--;
+            why = 'full:dirty';
+        }
+
+        this.size(w, h);
+        try {
+            if (why !== null) {
+                this.measure(world, eyeX, eyeY, eyeZ, maxLevel, eyeYaw, eyePitch, out, now);
+                return this.count(why);
+            }
+
+            return this.count(this.partial(world, eyeX, eyeY, eyeZ, maxLevel, eyeYaw, eyePitch, out, click, now));
+        } catch (e) {
+            // a fault here must not break the game: upstream's frame, now and from then on
+            this.enabled = false;
+            this.drop();
+            console.error('IncrRender: off after an error', e);
+            out.fill(0, 0, w * h);
+            this.plain(world, eyeX, eyeY, eyeZ, maxLevel, eyeYaw, eyePitch);
+            return this.count('full:error');
+        }
+    }
+
+    // no reference while the camera moves (or the render is off): what the last frames drew is let go, so a rebuilt
+    // map's models or gone players are not kept alive by it
+    private static drop(): void {
+        this.ref.valid = false;
+        this.ref.clear();
+        this.cur.clear();
+        if (this.byObj.size !== 0) {
+            this.byObj.clear();
+        }
+    }
+
+    private static count(what: string): string {
+        this.lastPartial = what === 'partial';
+        if (what === 'partial') {
+            this.stats.partial++;
