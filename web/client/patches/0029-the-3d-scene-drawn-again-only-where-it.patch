+    static get partialCount(): number {
+        return this.stats.partial;
+    }
+
+    // what the persistent 3D frame holds (tests)
+    static get frame3dPixels(): Int32Array {
+        return this.frame3d;
+    }
+
+    static get verifyBuild(): boolean {
+        return LC_INCR_VERIFY;
+    }
+
+    private static lastPartial: boolean = false;
+
+    // whether the last frame drew the pixel (x, y) again (a full frame draws every pixel)
+    static regionHas(x: number, y: number): boolean {
+        if (!this.lastPartial) {
+            return true;
+        }
+        const tx: number = x >> Pix3D.INCR_TILE_SHIFT;
+        return (this.region[(y >> Pix3D.INCR_TILE_SHIFT) * this.words + (tx >> 5)] & (1 << (tx & 31))) !== 0;
