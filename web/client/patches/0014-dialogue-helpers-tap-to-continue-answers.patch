+    // custom (ios): the buttons of the chat modal a click can reach, walking its tree like addComponentOptions (hidden
+    // layers skipped, each child clipped to its layers and the chatbox, scrolled with its layer), with their clickable
+    // rects in virtual coordinates. Any component with a button type counts, and any inventory.
+    private chatButtons(): ButtonRect[] {
+        const buttons: ButtonRect[] = [];
+        const root: IfType | undefined = IfType.list[this.chatModalId];
+        if (root) {
+            // buildMinimenu's chatbox test: 17 < x < 496, 357 < y < 453
+            this.collectButtons(root, CHAT_RECT.x, CHAT_RECT.y, 0, CHAT_RECT.x + 1, CHAT_RECT.y + 1, CHAT_RECT.x + CHAT_RECT.w, CHAT_RECT.y + CHAT_RECT.h, buttons);
+        }
+        return buttons;
+    }
+
+    // custom (ios): see chatButtons (clip: left/top inclusive, right/bottom exclusive)
+    private collectButtons(com: IfType, x: number, y: number, scrollPosition: number, left: number, top: number, right: number, bottom: number, buttons: ButtonRect[]): void {
+        if (com.type !== ComponentType.TYPE_LAYER || !com.children || com.hide || !com.childX || !com.childY) {
+            return;
+        }
+
+        // addComponentOptions: a layer takes x..x + width inclusive
+        left = Math.max(left, x);
+        top = Math.max(top, y);
+        right = Math.min(right, x + com.width + 1);
+        bottom = Math.min(bottom, y + com.height + 1);
+
+        for (let i: number = 0; i < com.children.length; i++) {
+            const child: IfType | undefined = IfType.list[com.children[i]];
+            if (!child) {
+                continue;
+            }
+
+            const childX: number = com.childX[i] + x + child.x;
+            const childY: number = com.childY[i] + y - scrollPosition + child.y;
+
+            if (child.type === ComponentType.TYPE_LAYER) {
+                this.collectButtons(child, childX, childY, child.scrollPos, left, top, right, bottom, buttons);
+            } else if (child.buttonType !== 0 || child.type === ComponentType.TYPE_INV) {
+                const width: number = child.type === ComponentType.TYPE_INV ? child.width * (child.marginX + 32) : child.width;
+                const height: number = child.type === ComponentType.TYPE_INV ? child.height * (child.marginY + 32) : child.height;
+                const x0: number = Math.max(left, childX);
+                const y0: number = Math.max(top, childY);
+                const x1: number = Math.min(right, childX + width);
+                const y1: number = Math.min(bottom, childY + height);
+                if (x1 > x0 && y1 > y0) {
+                    buttons.push({ com: child, x: x0, y: y0, w: x1 - x0, h: y1 - y0 });
+                }
+            }
+        }
+    }
