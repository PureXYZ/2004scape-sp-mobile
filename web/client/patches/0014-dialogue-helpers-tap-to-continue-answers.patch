+    // custom (ios): host API. The open dialogue's answers (NPC dialogue choices, the ::~help menu, "what would you like
+    // to make" items), or null when no dialogue shows in the chatbox. The answers are the chat modal's text buttons
+    // that resume a dialogue (buttontype "normal") and have a text; a "Click here to continue" is not one (see
+    // chatContinue), nor are the skill menus' unlabelled Make 1/5/10/X areas.
+    public hudDialog(): HudDialog | null {
+        if (!this.ingame || this.chatModalId === -1 || this.tutComMessage !== null || this.dialogInputOpen || this.socialInputOpen) {
+            return null;
+        }
+
+        const options: HudDialogOption[] = [];
+        for (const button of this.chatButtons()) {
+            const com: IfType = button.com;
+            if (com.type !== ComponentType.TYPE_TEXT || com.buttonType !== ButtonType.BUTTON_OK) {
+                continue;
+            }
+
+            // drawInterface's text
+            const text: string | null = this.getIfActive(com) && com.text2 ? com.text2 : com.text;
+            if (text && text.replace(/@...@/g, '').trim().length > 0) {
+                options.push({ text, x: button.x, y: button.y, w: button.w, h: button.h });
+            }
+        }
+
+        options.sort((a: HudDialogOption, b: HudDialogOption): number => a.y - b.y || a.x - b.x);
+        return { options };
+    }
