+    // custom (ios): the texts of an interface's text components in tree order, joined (identifies what it shows)
+    private interfaceText(com: IfType | undefined): string {
+        if (!com) {
+            return '';
+        }
+
+        if (com.type === ComponentType.TYPE_TEXT) {
+            return com.text ?? '';
+        }
+
+        return com.type === ComponentType.TYPE_LAYER && com.children ? com.children.map((id: number): string => this.interfaceText(IfType.list[id])).join('|') : '';
