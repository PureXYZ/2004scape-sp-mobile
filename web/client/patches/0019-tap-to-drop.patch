+    // custom (ios): host API. Tap-to-drop (the HUD's drop button, as on OSRS mobile): while on, a tap on an item in the
+    // inventory tab drops it (its fifth op: "Drop", or what the item calls it) instead of doing its first op. A
+    // long-press still opens the item's menu and a drag still moves it; a use or target mode ("Use Tinderbox with...",
+    // a spell on an item) and the inventories of side modals (bank, shop, trade) are unchanged. Returns the mode now on.
+    public setTapToDrop(on: boolean): boolean {
+        this.tapToDrop = on === true;
+        return this.tapToDrop;
+    }
+
+    // custom (ios): with tap-to-drop on, the menu entry that drops the item a tap in the side panel acts on (the top
+    // entry's slot: upstream does the top entry), else -1. Only when the top entry is one of the item's own ops in the
+    // tab panel, not a side modal's (bank, shop, trade: their items have other ops), so a use or target mode, whose
+    // entries are "Use X with Y" or the spell, is unchanged.
+    private tapDropOption(dragArea: number): number {
+        if (!this.tapToDrop || dragArea !== 2 || this.sideModalId !== -1 || this.menuNumEntries < 2) {
+            return -1;
+        }
+
+        const top: number = this.menuNumEntries - 1;
+        const action: number = this.menuAction[top];
+        if (
+            action !== MiniMenuAction.OP_HELD1 && action !== MiniMenuAction.OP_HELD2 && action !== MiniMenuAction.OP_HELD3 && action !== MiniMenuAction.OP_HELD4 && action !== MiniMenuAction.OP_HELD5 &&
+            action !== MiniMenuAction.USEHELD_START
+        ) {
+            return -1;
+        }
+
+        for (let i: number = top; i > 0; i--) {
+            if (this.menuAction[i] === MiniMenuAction.OP_HELD5 && this.menuParamB[i] === this.menuParamB[top] && this.menuParamC[i] === this.menuParamC[top]) {
+                return i;
+            }
+        }
+
+        return -1;
+    }
