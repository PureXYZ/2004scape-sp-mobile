+
+    // custom (ios): the system took the gesture over (Control Center, a native gesture, a pinch...). Release
+    // whatever the gesture holds and never turn it into a click.
+    protected pointerCancel(_e: PointerEvent) {
+        this.nextMouseClickX = -1;
+        this.nextMouseClickY = -1;
+        this.nextMouseClickButton = 0;
+        this.mouseButton = 0;
+    }
+
+    /// custom (ios): one finger drives the canvas at a time, so multi-touch cannot produce extra clicks, drags or
+    /// camera moves; other touch/pen pointers are ignored until they lift. `e.isPrimary` alone is not enough: a
+    /// finger resting on a host overlay button (outside the canvas) makes every later canvas touch non-primary.
+    private canvasPointerId: number = -1;
+    private readonly ignoredCanvasPointers: Set<number> = new Set();
+
+    private acceptPointer(e: PointerEvent, phase: 'down' | 'up' | 'other'): boolean {
+        if (e.pointerType === 'mouse') {
+            return true;
+        }
+
+        const id: number = e.pointerId;
+        if (this.ignoredCanvasPointers.has(id)) {
+            if (phase === 'up') {
+                this.ignoredCanvasPointers.delete(id);
+            }
+            return false;
+        }
+
+        if (phase === 'down') {
+            if (e.isPrimary) {
+                // no other touch is down anywhere, so anything still tracked is stale (a lost pointerup)
+                this.ignoredCanvasPointers.clear();
+            } else if (this.canvasPointerId !== -1 && this.canvasPointerId !== id) {
+                this.ignoredCanvasPointers.add(id);
+                return false;
+            }
+
+            this.canvasPointerId = id;
+            return true;
+        }
+
+        if (this.canvasPointerId !== -1 && this.canvasPointerId !== id) {
+            return false;
+        }
+
+        if (phase === 'up') {
+            this.canvasPointerId = -1;
+        }
+        return true;
+    }
+
+    // custom (ios): give the canvas keyboard focus on touch as well, so a hardware keyboard types into the game,
+    // but never take focus away from a text field (the desktop keyboard fallback input).
+    private focusCanvas(): void {
+        const active: Element | null = document.activeElement;
+        if (active !== canvas && !(active instanceof HTMLInputElement || active instanceof HTMLTextAreaElement)) {
+            canvas.focus({ preventScroll: true });
+        }
+    }
