+    // custom (ios): report state changes to the host page (lcHost.onClientEvent, optional): 'ingame' (boolean),
+    // 'menu-open' ({ area, x, y, width, height, options: top to bottom as drawn, colour tags included }) and
+    // 'menu-close'. The menu is not rebuilt while it is open, so reading it one cycle late is exact.
+    private hostIngame: boolean = false;
+    private hostMenuOpen: boolean = false;
+
+    private syncHostEvents(): void {
+        if (this.ingame !== this.hostIngame) {
+            this.hostIngame = this.ingame;
+            lcEvent('ingame', this.ingame);
+        }
+
+        if (this.isMenuOpen !== this.hostMenuOpen) {
+            this.hostMenuOpen = this.isMenuOpen;
+
+            if (this.isMenuOpen) {
+                const options: string[] = [];
+                for (let i: number = this.menuNumEntries - 1; i >= 0; i--) {
+                    options.push(this.menuOption[i]);
+                }
+
+                lcEvent('menu-open', { area: this.menuArea, x: this.menuX, y: this.menuY, width: this.menuWidth, height: this.menuHeight, options });
+            } else {
+                lcEvent('menu-close');
+            }
+        }
