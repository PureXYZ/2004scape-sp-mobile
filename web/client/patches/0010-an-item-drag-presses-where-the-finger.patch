             this.sx = this.nx = this.mx = e.screenX | 0;
             this.sy = this.ny = this.my = e.screenY | 0;
             this.ttime = e.timeStamp;
+            this.touchStartX = x; // custom (ios): the press point of a drag
+            this.touchStartY = y;
 
             this.startedInGame = this.insideGame();
             this.startedInSide = this.insideSide();
@@ -12124,8 +12126,19 @@ export class Client extends GameShell {
                 if (!this.dragging && this.exceedsGrabThreshold(TOUCH_SLOP)) {
                     this.dragging = true;
 
-                    this.nextMouseClickX = x;
-                    this.nextMouseClickY = y;
