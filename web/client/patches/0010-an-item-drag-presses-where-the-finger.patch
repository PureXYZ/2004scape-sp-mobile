+                    // over the neighbouring item. mouseLoop takes the dragged slot from the minimenu, which the last
+                    // draw built at the current position, so rebuild that for the press point (no draw runs before
+                    // the mainloop that handles this press).
+                    if (!this.isMenuOpen) {
+                        this.mouseX = this.touchStartX;
+                        this.mouseY = this.touchStartY;
+                        this.buildMinimenu();
+                        this.mouseX = x;
+                        this.mouseY = y;
+                    }
+                    this.nextMouseClickX = this.touchStartX;
+                    this.nextMouseClickY = this.touchStartY;
                     this.nextMouseClickButton = 1;
                     this.mouseButton = 1;
                 }
