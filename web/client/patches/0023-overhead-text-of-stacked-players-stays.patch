+    // custom (ios): the entity drawn on each tile this scene cycle (valid where tileLastOccupiedCycle == sceneCycle)
+    private tileOccupant: (ClientEntity | null)[][] = Array.from({ length: BuildArea.SIZE }, () => new Array(BuildArea.SIZE).fill(null));
     private sceneCycle: number = 0;
 
     private projectX: number = 0;
@@ -4562,10 +4564,14 @@ export class Client extends GameShell {
