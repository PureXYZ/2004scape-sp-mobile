+// custom (ios): the world map of the iOS app's HUD (web/host/mapview.html, in the World map window's iframe).
+//
+// Upstream's 2004 map applet (MapView) with a phone's controls in place of its own buttons and keys: drag to pan (it
+// glides on), pinch to zoom, double-tap to zoom in and a two-finger tap to zoom out. Zooming settles on the applet's
+// four zooms (37, 50, 75 and 100 %), the only ones its labels are drawn at. It draws the player where they are, the
+// applet's overview in the bottom right corner when asked, and flashes the icons of a key (the Key list is the host's).
+// The surface, the underground and the other places are MapView's three maps (reloadMain/Dungeon/Extra).
+//
+// The host talks to it with postMessage, { lcMap: <type>, ... }:
+//   show { player }   the window opened: shows the map the player is on, centred on them (player: { x, z } or null)
+//   player { x, z }   the player moved
+//   centre            glide back to the player
+//   area { area }     0 surface, 1 underground, 2 other places
+//   overview { on }   show or hide the overview
+//   key { index }     flash every icon of a key (MapView.keyNames), gliding to the nearest when none is in view
+//   pause             the window closed: the loop sleeps until the next show
+// and it answers { lcMap: 'state', ready, loading, area } whenever one of those changes, and { lcMap: 'keys', area, keys }
+// once a map has loaded: the keys it has icons of, [{ index, name }] by name.
+
+import { canvas } from '#/graphics/Canvas.js';
+import Pix2D from '#/graphics/Pix2D.js';
+import PixMap from '#/graphics/PixMap.js';
+import { MapView } from '#/mapview/MapView.js';
+
+// MapView's maps, in tiles (from reloadMain, reloadDungeon and reloadExtra): where each starts, and its focus at first
+const AREAS = [
+    { originX: 32 << 6, originZ: 41 << 6, width: 25 << 6, height: 22 << 6, startX: 50 << 6, startZ: 50 << 6 },
+    { originX: 32 << 6, originZ: 141 << 6, width: 25 << 6, height: 22 << 6, startX: 50 << 6, startZ: 150 << 6 },
+    { originX: 28 << 6, originZ: 63 << 6, width: 21 << 6, height: 17 << 6, startX: 39 << 6, startZ: 74 << 6 }
+];
+
+// MapView.zoom is twice the pixels per tile; its labels are drawn at these zooms only
+const ZOOMS = [3, 4, 6, 8];
+const START_ZOOM = 6;
+const MARGIN = 48; // tiles round the edge of a map that the view stays out of (MapView.mainloop)
+const BUFFER_PAD = 16; // px the drawing buffer has beyond the canvas: the view lies in it at a fraction of a tile
+const OVERVIEW_H = 120;
+const OVERVIEW_GAP = 6;
+const TAP_SLOP = 8; // px a finger may move and still tap
+const DOUBLE_TAP_MS = 300;
+const TWO_FINGER_TAP_MS = 250;
+const GLIDE_DECAY = 0.92; // of the speed per cycle (50 a second) after a pan
+const GLIDE_STOP = 0.2; // px per cycle
+const ZOOM_EASE = 0.35; // of the way to the zoom aimed at, per cycle
+const CENTRE_EASE = 0.25; // of the way to a place being glided to, per cycle
+const FLASH_CYCLES = 100; // how long a key's icons flash (upstream: 50)
+const MARKER_BLINK_MS = 500;
+
+type Gesture =
+    | { kind: 'pan'; id: number; x0: number; y0: number; fx0: number; fz0: number; moved: boolean; samples: { x: number; y: number; t: number }[] }
+    | { kind: 'pinch'; d0: number; zoom0: number; tileX: number; tileZ: number; mx0: number; my0: number; moved: boolean; t0: number }
+    | { kind: 'overview'; id: number }
+    | null;
+
+type Message = { lcMap?: string; player?: { x: number; z: number } | null; x?: number; z?: number; area?: number; on?: boolean; index?: number };
+
+export class MobileMapView extends MapView {
+    // the view's centre, in tiles of the current map (fractions too: MapView.focusX/Z are whole tiles)
+    private fx: number = 0;
+    private fz: number = 0;
+
+    private ready: boolean = false;
+    private loading: boolean = false;
+    private wantArea: number = -1; // an area asked for while one was loading
+    private player: { x: number; z: number } | null = null; // world tile
+    private showPending: boolean = false; // centre on the player once the map is ready
+    private spotPending: { x: number; z: number } | null = null; // ...or on this world tile
+
+    private pointers: Map<number, { x: number; y: number }> = new Map();
+    private gesture: Gesture = null;
+    private lastTap: { x: number; y: number; t: number } | null = null;
+    private velocity: { x: number; y: number } | null = null; // px per cycle, gliding after a pan
+    private zoomTo: { zoom: number; ax: number; ay: number; tileX: number; tileZ: number } | null = null;
+    private glideTo: { x: number; z: number } | null = null;
+
+    private view: PixMap | null = null; // the buffer the map is drawn in, BUFFER_PAD wider and taller than the canvas
+    private mapPixels: Int32Array = new Int32Array(0); // the drawn map, without what goes on top of it
+    private mapKey: string = ''; // what mapPixels shows
+    private shownKey: string = ''; // what the canvas shows
+    private paused: boolean = false;
+    private resume: (() => void) | null = null;
+    private lastState: string = '';
+
+    private started: boolean = false; // the first maininit has begun
+    private early: Message[] = []; // what the host said before that
+
+    private readonly onMessage = (e: MessageEvent): void => this.message(e.data as Message);
+    private readonly onResize = (): void => this.fitCanvas();
+
+    constructor() {
+        super(); // (which starts GameShell.run: maininit follows once it yields)
+        window.addEventListener('message', this.onMessage);
+    }
+
+    override async maininit(): Promise<void> {
+        const first = !this.started;
+        if (first) {
+            this.started = true;
+            this.bindInput();
+            window.addEventListener('resize', this.onResize);
+
+            // the first map: the one the player is on (mapview.html?x=&z=), so it is not loaded twice
+            const query = new URLSearchParams(location.search);
+            const x = Number(query.get('x'));
+            const z = Number(query.get('z'));
+            if (query.has('x') && Number.isFinite(x) && Number.isFinite(z)) {
+                this.player = { x, z };
+                this.showPending = true;
+            }
+            this.setArea(this.areaOf(this.player) ?? 0);
+            this.zoom = this.targetZoom = START_ZOOM;
+        }
+
+        this.ready = false;
+        this.loading = true;
+        this.postState();
+        if (first) {
+            for (const data of this.early.splice(0)) {
+                this.message(data);
+            }
+        }
+        this.overviewHeight = OVERVIEW_H;
+        this.activeMapFunctionCount = 0; // (upstream's reloads count on from the last map's)
+        await super.maininit();
+        this.floort1 = []; // only needed to blend the ground colours
+        this.loading = false;
+        this.ready = true;
+        this.fitCanvas();
+
+        // (where to look waits for the map asked for meanwhile, if another)
+        const next = this.wantArea;
+        this.wantArea = -1;
+        if (next === -1 || next === this.mapArea) {
+            if (this.showPending) {
+                this.showPending = false;
+                this.centreOnPlayer(false);
+            } else if (this.spotPending && this.areaOf(this.spotPending) === this.mapArea) {
+                const at = this.toMap(this.spotPending);
+                this.fx = at.x;
+                this.fz = at.z;
+                this.clampFocus();
+            }
+            this.spotPending = null;
+        }
+        this.postState();
+        this.postKeys();
+
+        if (next !== -1 && next !== this.mapArea) {
+            await this.switchArea(next);
+        }
+    }
+
+    // ---- host messages
+
+    private message(data: Message): void {
+        if (!data || typeof data.lcMap !== 'string') {
+            return;
+        }
+        if (!this.started) {
+            this.early.push(data);
+            return;
+        }
+
+        switch (data.lcMap) {
+            case 'show': {
+                this.player = data.player ?? null;
+                this.unpause();
+                const area = this.areaOf(this.player);
+                if (area !== null && area !== this.mapArea) {
+                    this.showPending = true;
+                    void this.switchArea(area);
+                } else if (this.ready) {
+                    this.centreOnPlayer(false);
+                } else {
+                    this.showPending = true;
+                }
+                break;
+            }
+            case 'player':
+                if (typeof data.x === 'number' && typeof data.z === 'number') {
+                    this.player = { x: data.x, z: data.z };
+                }
+                break;
+            case 'centre': {
+                const area = this.areaOf(this.player);
+                if (area !== null && area !== this.mapArea) {
+                    this.showPending = true;
+                    void this.switchArea(area);
+                } else {
+                    this.centreOnPlayer(true);
+                }
+                break;
+            }
+            case 'area':
+                if (typeof data.area === 'number' && AREAS[data.area] && data.area !== this.mapArea) {
+                    this.showPending = false;
+                    this.spotPending = this.ready ? this.spotOn(data.area) : null;
+                    void this.switchArea(data.area);
+                }
+                break;
+            case 'overview':
+                this.showOverview = data.on === true;
+                break;
+            case 'key':
+                if (typeof data.index === 'number') {
+                    this.flashKey(data.index);
+                }
+                break;
+            case 'pause':
+                this.paused = true;
+                this.gesture = null;
+                this.pointers.clear();
+                break;
+        }
+    }
+
+    private postState(): void {
+        const state = { lcMap: 'state', ready: this.ready, loading: this.loading, area: this.mapArea };
+        const key = JSON.stringify(state);
+        if (key !== this.lastState) {
+            this.lastState = key;
+            window.parent?.postMessage(state, '*');
+        }
+    }
+
+    private postKeys(): void {
+        const found = new Set<number>();
+        for (let i = 0; i < this.activeMapFunctionCount; i++) {
+            found.add(this.activeMapFunctions[i]);
+        }
+        const keys = [...found].filter(index => this.keyNames[index] && this.keyNames[index] !== '???').map(index => ({ index, name: this.keyNames[index] }));
+        keys.sort((a, b) => a.name.localeCompare(b.name));
+        window.parent?.postMessage({ lcMap: 'keys', area: this.mapArea, keys }, '*');
+    }
+
+    private unpause(): void {
+        this.paused = false;
+        this.resume?.();
+        this.resume = null;
+    }
+
+    // ---- maps
+
+    // which map a world tile is on, or null when none
+    private areaOf(tile: { x: number; z: number } | null): number | null {
+        if (!tile) {
+            return null;
+        }
+        const area = AREAS.findIndex(a => tile.x >= a.originX && tile.x < a.originX + a.width && tile.z >= a.originZ && tile.z < a.originZ + a.height);
+        return area === -1 ? null : area;
+    }
+
+    private setArea(area: number): void {
+        const a = AREAS[area];
+        this.mapArea = area;
+        this.mapOriginX = a.originX;
+        this.mapOriginZ = a.originZ;
+        this.mapWidth = a.width;
+        this.mapHeight = a.height;
+        this.mapStartX = a.startX;
+        this.mapStartZ = a.startZ;
+        this.fx = a.startX - a.originX;
+        this.fz = a.originZ + a.height - a.startZ;
+        this.focusX = this.fx | 0;
+        this.focusZ = this.fz | 0;
+        this.mapKey = '';
+        this.shownKey = '';
+        this.flashTimer = 0;
+        this.velocity = null;
+        this.glideTo = null;
+    }
+
+    private async switchArea(area: number): Promise<void> {
+        if (this.loading) {
+            this.wantArea = area;
+            return;
+        }
+        if (area === this.mapArea) {
+            if (this.showPending) {
+                this.showPending = false;
+                this.centreOnPlayer(true);
+            }
+            return;
+        }
+        this.setArea(area);
+        Pix2D.cls();
+        this.fullredraw = true;
+        await this.maininit();
+    }
+
+    // What lies under (or over) the view's centre on another map: the underground is the surface 6400 tiles north. Null
+    // for the other places, which lie nowhere in particular.
+    private spotOn(area: number): { x: number; z: number } | null {
+        const dz = this.mapArea === 0 && area === 1 ? 6400 : this.mapArea === 1 && area === 0 ? -6400 : null;
+        if (dz === null) {
+            return null;
+        }
+        const spot = { x: Math.floor(this.fx) + this.mapOriginX, z: this.mapOriginZ + this.mapHeight - 1 - Math.floor(this.fz) + dz };
+        return this.areaOf(spot) === area ? spot : null;
+    }
+
+    // a world tile's centre in tiles of the current map (MapView.loadUnderlay: rows run north to south)
+    private toMap(tile: { x: number; z: number }): { x: number; z: number } {
+        return { x: tile.x - this.mapOriginX + 0.5, z: this.mapOriginZ + this.mapHeight - tile.z - 0.5 };
+    }
+
+    private centreOnPlayer(glide: boolean): void {
+        if (!this.player || this.areaOf(this.player) !== this.mapArea) {
+            return;
+        }
+        const at = this.toMap(this.player);
+        this.velocity = null;
+        if (glide) {
+            this.glideTo = at;
+        } else {
+            this.glideTo = null;
+            this.fx = at.x;
+            this.fz = at.z;
+            this.clampFocus();
+        }
+    }
+
+    private flashKey(index: number): void {
+        this.currentKey = index;
+        this.flashTimer = FLASH_CYCLES;
+
+        // none in view: glide to the nearest
+        const view = this.viewRect();
+        let nearest = -1;
+        let best = Infinity;
+        for (let i = 0; i < this.activeMapFunctionCount; i++) {
+            if (this.activeMapFunctions[i] !== index) {
+                continue;
+            }
+            const x = this.activeMapFunctionX[i] + 0.5;
+            const z = this.activeMapFunctionZ[i] + 0.5;
+            if (x >= view.left && x < view.right && z >= view.top && z < view.bottom) {
+                return;
+            }
+            const d = (x - this.fx) ** 2 + (z - this.fz) ** 2;
+            if (d < best) {
+                best = d;
+                nearest = i;
+            }
+        }
+        if (nearest !== -1) {
+            this.velocity = null;
+            this.glideTo = { x: this.activeMapFunctionX[nearest] + 0.5, z: this.activeMapFunctionZ[nearest] + 0.5 };
+        }
+    }
+
+    // ---- view
+
+    private get ppt(): number {
+        return this.zoom / 2; // px per tile
+    }
+
+    // the tiles in view (fractions too)
+    private viewRect(): { left: number; top: number; right: number; bottom: number } {
+        const halfW = this.sWid / 2 / this.ppt;
+        const halfH = this.sHei / 2 / this.ppt;
+        return { left: this.fx - halfW, top: this.fz - halfH, right: this.fx + halfW, bottom: this.fz + halfH };
+    }
+
+    // a canvas point's tile, at a zoom
+    private tileAt(x: number, y: number, zoom: number = this.zoom): { x: number; z: number } {
+        return { x: this.fx + (x - this.sWid / 2) / (zoom / 2), z: this.fz + (y - this.sHei / 2) / (zoom / 2) };
+    }
+
+    // the focus that puts a tile at a canvas point, at a zoom
+    private focusFor(tileX: number, tileZ: number, x: number, y: number, zoom: number): void {
+        this.fx = tileX - (x - this.sWid / 2) / (zoom / 2);
+        this.fz = tileZ - (y - this.sHei / 2) / (zoom / 2);
+    }
+
+    private clampFocus(): void {
+        const halfW = this.sWid / 2 / this.ppt;
+        const halfH = this.sHei / 2 / this.ppt;
+        const clamp = (v: number, lo: number, hi: number): number => (lo > hi ? (lo + hi) / 2 : Math.min(hi, Math.max(lo, v)));
+        this.fx = clamp(this.fx, MARGIN + halfW, this.mapWidth - MARGIN - halfW);
+        this.fz = clamp(this.fz, MARGIN + halfH, this.mapHeight - MARGIN - halfH);
+        this.focusX = this.fx | 0;
+        this.focusZ = this.fz | 0;
+    }
+
+    private fitCanvas(): void {
+        const width = Math.max(1, window.innerWidth | 0);
+        const height = Math.max(1, window.innerHeight | 0);
+        if (width !== this.sWid || height !== this.sHei || !this.view) {
+            this.resize(width, height);
+            this.view = new PixMap(width + BUFFER_PAD, height + BUFFER_PAD);
+            this.mapPixels = new Int32Array((width + BUFFER_PAD) * (height + BUFFER_PAD));
+            this.drawArea?.setPixels();
+        }
+        this.overviewX = this.sWid - this.overviewWidth - OVERVIEW_GAP;
+        this.overviewY = this.sHei - this.overviewHeight - OVERVIEW_GAP;
+        this.mapKey = '';
+        this.shownKey = '';
+        this.clampFocus();
+    }
+
+    // ---- input: our own pointer handling, not GameShell's (one finger, mouse emulation)
+
+    private bindInput(): void {
+        canvas.onmousedown = null;
+        canvas.onmouseup = null;
+        canvas.onpointerdown = null;
+        canvas.onpointerup = null;
+        canvas.onpointermove = null;
+        canvas.onpointerenter = null;
+        canvas.onpointerleave = null;
