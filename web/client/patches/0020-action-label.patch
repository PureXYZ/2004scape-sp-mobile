+    // custom (ios): where virtual (x, y) shows in the page (CSS px, like clientX/Y): on the surface whose rect holds it,
+    // else on the canvas; null if nothing shows it
+    protected pagePoint(x: number, y: number): { x: number; y: number } | null {
+        for (const [el, r] of this.surfaces) {
+            if (x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h) {
+                const box: DOMRect = el.getBoundingClientRect();
+                if (box.width > 0 && box.height > 0) {
+                    return { x: box.left + ((x - r.x) * box.width) / r.w, y: box.top + ((y - r.y) * box.height) / r.h };
+                }
+            }
+        }
+
+        const box: DOMRect = canvas.getBoundingClientRect();
+        if (box.width > 0 && box.height > 0 && !this.isFullScreen() && x >= 0 && y >= 0 && x < canvas.width && y < canvas.height) {
+            return { x: box.left + (x * box.width) / canvas.width, y: box.top + (y * box.height) / canvas.height };
+        }
+
+        return null;
+    }
+
