+    // custom (ios): on a touch screen nothing hovers and the finger covers what it taps, so an action that starts a red
+    // cross (on an NPC, player, loc or ground item, also from the long-press menu) or acts on an item in a slot (an
+    // inventory, worn equipment, the bank, a shop) tells the host what it was, which shows it beside that point for a
+    // moment (the action label): lcEvent 'action-label' { text: the option as drawn, colour tags included ("Attack
+    // @yel@Goblin@gre@ (level-2)"), x, y: the red cross or the tapped point, in page px }
     private doAction(optionId: number): void {
+        if (!this.isMobile || optionId < 0) {
+            this.doMenuAction(optionId);
+            return;
+        }
+
+        const option: string = this.menuOption[optionId];
+        let action: number = this.menuAction[optionId];
+        if (action >= MiniMenuAction._PRIORITY) {
+            action -= MiniMenuAction._PRIORITY;
+        }
+
+        const x: number = this.mouseClickX;
+        const y: number = this.mouseClickY;
+        const crossStarted: boolean = this.crossMode === 2 && this.crossCycle === 0;
+
+        this.doMenuAction(optionId);
+
+        let at: { x: number; y: number } | null = null;
+        if (this.crossMode === 2 && this.crossCycle === 0 && !crossStarted) {
+            at = this.pagePoint(this.crossX, this.crossY);
+        } else if (Client.isSlotAction(action)) {
+            at = this.pagePoint(x, y);
+        }
+
+        if (at) {
+            lcEvent('action-label', { text: option, x: at.x, y: at.y });
+        }
+    }
+
+    // custom (ios): an action on an item in a slot (an inventory, worn equipment, the bank, a shop)
+    private static isSlotAction(action: number): boolean {
+        return (
+            action === MiniMenuAction.OP_HELD1 ||
+            action === MiniMenuAction.OP_HELD2 ||
+            action === MiniMenuAction.OP_HELD3 ||
+            action === MiniMenuAction.OP_HELD4 ||
+            action === MiniMenuAction.OP_HELD5 ||
+            action === MiniMenuAction.OP_HELD6 ||
+            action === MiniMenuAction.TGT_HELD ||
+            action === MiniMenuAction.USEHELD_START ||
+            action === MiniMenuAction.USEHELD_ONHELD ||
+            action === MiniMenuAction.INV_BUTTON1 ||
+            action === MiniMenuAction.INV_BUTTON2 ||
+            action === MiniMenuAction.INV_BUTTON3 ||
+            action === MiniMenuAction.INV_BUTTON4 ||
+            action === MiniMenuAction.INV_BUTTON5
+        );
+    }
+
+    private doMenuAction(optionId: number): void {
         if (optionId < 0) {
             return;
         }
