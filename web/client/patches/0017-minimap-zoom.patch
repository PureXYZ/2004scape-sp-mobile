+    public setMinimapZoom(zoom: number): number {
+        if (Number.isFinite(zoom)) {
+            this.minimapZoom = Math.min(MINIMAP_ZOOM_MAX, Math.max(MINIMAP_ZOOM_MIN, zoom));
+        }
+
+        return this.minimapZoom;
