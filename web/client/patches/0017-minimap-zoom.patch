+    // custom (ios): scanlineRotatePlotSprite for the zoomable minimap (Client.minimapPlot): the anchor may fall between
+    // two pixels, and a pixel past the image's edge is black (upstream's sampling wraps round to the other side).
+    scanlineRotatePlotSpriteClipped(x: number, y: number, w: number, h: number, anchorX: number, anchorY: number, theta: number, zoom: number, lineStart: Int32Array, lineWidth: Int32Array): void {
+        x |= 0;
+        y |= 0;
+        w |= 0;
+        h |= 0;
+
+        const centerX: number = (-w / 2) | 0;
+        const centerY: number = (-h / 2) | 0;
+
+        const sin: number = (Math.sin(theta / 326.11) * 65536.0) | 0;
+        const cos: number = (Math.cos(theta / 326.11) * 65536.0) | 0;
+        const sinZoom: number = (sin * zoom) >> 8;
+        const cosZoom: number = (cos * zoom) >> 8;
+
+        let leftX: number = Math.round(anchorX * 65536) + centerY * sinZoom + centerX * cosZoom;
+        let leftY: number = Math.round(anchorY * 65536) + (centerY * cosZoom - centerX * sinZoom);
+        let leftOff: number = x + y * Pix2D.width;
+
+        const data: Int32Array = this.data;
+        const wi: number = this.wi;
+        const hi: number = this.hi;
+
+        for (let i: number = 0; i < h; i++) {
+            const dstOff: number = lineStart[i];
+            let dstX: number = leftOff + dstOff;
+
+            let srcX: number = leftX + cosZoom * dstOff;
+            let srcY: number = leftY - sinZoom * dstOff;
+
+            for (let j: number = -lineWidth[i]; j < 0; j++) {
+                const sx: number = srcX >> 16;
+                const sy: number = srcY >> 16;
+                Pix2D.pixels[dstX++] = sx >= 0 && sy >= 0 && sx < wi && sy < hi ? data[sx + sy * wi] : 0;
+                srcX += cosZoom;
+                srcY -= sinZoom;
+            }
+
+            leftX += sinZoom;
+            leftY += cosZoom;
+            leftOff += Pix2D.width;
+        }
+    }
+
+    // custom (ios): a half-size copy, each pixel the mean of the 2x2 under it (the zoomed-out minimap: Client.minimapPlot)
+    halved(): Pix32 {
+        const wi: number = this.wi >> 1;
+        const hi: number = this.hi >> 1;
+        const half: Pix32 = new Pix32(wi, hi);
+        const src: Int32Array = this.data;
+        const dst: Int32Array = half.data;
+
+        for (let y: number = 0; y < hi; y++) {
+            let srcOff: number = y * 2 * this.wi;
+            let dstOff: number = y * wi;
+
+            for (let x: number = 0; x < wi; x++) {
+                const a: number = src[srcOff];
+                const b: number = src[srcOff + 1];
+                const c: number = src[srcOff + this.wi];
+                const d: number = src[srcOff + this.wi + 1];
+                const rb: number = ((a & 0xff00ff) + (b & 0xff00ff) + (c & 0xff00ff) + (d & 0xff00ff)) >> 2;
+                const g: number = ((a & 0xff00) + (b & 0xff00) + (c & 0xff00) + (d & 0xff00)) >> 2;
+                dst[dstOff++] = (rb & 0xff00ff) | (g & 0xff00);
+                srcOff += 2;
+            }
+        }
+
+        return half;
+    }
