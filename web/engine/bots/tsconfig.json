{
    // Type-check only (esbuild builds the bots bundle; web/engine/bots/test/all.mjs runs tsc on it). The paths name the
    // sibling ../Server, as a tsconfig cannot read LC_UPSTREAM_DIR: the tests use a copy whose paths point at the upstream
    // folder scripts/lib/upstream.mjs resolves (derivedTsconfig), so an editor sees the sources only in that layout.
    // The bot library is checked against the read-only rev-274 engine sources it runs with. '#/engine/bot/*' must come
    // before '#/*': the bot folder lives here, everything else in Server/engine/src (one World, one Player).
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ESNext", "WebWorker"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "#/engine/bot/*": ["./src/*"],
            "#3rdparty/*": ["../../../../Server/engine/src/3rdparty/*"],
            "#/*": ["../../../../Server/engine/src/*"],
            "kleur": ["../../../../Server/engine/node_modules/kleur"],
            "@isaacs/ttlcache": ["../../../../Server/engine/node_modules/@isaacs/ttlcache"],
            "fflate": ["../../../../Server/engine/node_modules/fflate"]
        },
        "types": ["node"],
        "typeRoots": ["../../../../Server/engine/node_modules/@types"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "allowUnreachableCode": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
