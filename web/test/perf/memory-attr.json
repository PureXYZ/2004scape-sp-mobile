{
    "description": "Memory attribution (2026-10-27, the phone's ~1 GB WebContent at 1000 bots against the Mac's ~530 MB): short Activity Monitor samples (3 s: Instruments drops long ones at 500+ bots) of every process at the title, at Lumbridge once the bots are in, after WebKit's own low-memory handler (org.WebKit.lowMemory: it does nothing on iOS), at Varrock West's crowd and after the handler again, then with the chat model loaded and replying every 10 s. Run once per bot count (--bots 0, 500, 1000). The phone's Web Inspector (Memory categories, Heap.gc; e.g. through pymobiledevice3) can be read alongside.",
    "bots": 1000,
    "xctrace": true,
    "phases": [
        { "name": "title", "where": "title", "settleSec": 10, "sec": 60, "traces": [{ "set": "am", "at": 2, "sec": 3, "tag": "-a" }, { "set": "am", "at": 50, "sec": 3, "tag": "-b" }] },
        { "name": "lumbridge", "tele": "0,50,50,22,18", "waitFill": 300, "settleSec": 30, "sec": 240, "traces": [{ "set": "am", "at": 2, "sec": 3, "tag": "-a" }, { "set": "am", "at": 60, "sec": 3, "tag": "-b" }, { "set": "am", "at": 120, "sec": 3, "tag": "-c" }, { "set": "am", "at": 180, "sec": 3, "tag": "-d" }] },
        { "name": "lumbridge-lowmem", "webkitLowMemory": true, "settleSec": 0, "sec": 150, "traces": [{ "set": "am", "at": 0, "sec": 3, "tag": "-a" }, { "set": "am", "at": 50, "sec": 3, "tag": "-b" }, { "set": "am", "at": 110, "sec": 3, "tag": "-c" }] },
        { "name": "varrock", "tele": "0,49,53,49,44", "settleSec": 20, "sec": 180, "traces": [{ "set": "am", "at": 2, "sec": 3, "tag": "-a" }, { "set": "am", "at": 60, "sec": 3, "tag": "-b" }, { "set": "am", "at": 120, "sec": 3, "tag": "-c" }] },
        { "name": "varrock-lowmem", "webkitLowMemory": true, "settleSec": 0, "sec": 100, "traces": [{ "set": "am", "at": 0, "sec": 3, "tag": "-a" }, { "set": "am", "at": 55, "sec": 3, "tag": "-b" }] },
        { "name": "varrock-lm", "lm": { "everySec": 10, "think": true }, "settleSec": 5, "sec": 130, "traces": [{ "set": "am", "at": 5, "sec": 3, "tag": "-a" }, { "set": "am", "at": 65, "sec": 3, "tag": "-b" }, { "set": "am", "at": 120, "sec": 3, "tag": "-c" }] }
    ]
}
