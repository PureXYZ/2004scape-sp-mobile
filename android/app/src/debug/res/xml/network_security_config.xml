<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (this file replaces src/main's): the same as the release config, cleartext allowed for the native
  connections to game servers (online mode). The tests' stand-ins listen on 127.0.0.1 on the Mac (the Claude Messages
  API mock, web/test/lm/mock-claude.mjs; a local Engine-TS and online-stub.mjs), reached through `adb reverse`.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- (lint InsecureBaseConfiguration: on purpose, the player types the hosts) -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
